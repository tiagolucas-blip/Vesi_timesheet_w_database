# Copy to .env for local dev (never commit .env itself — it's in .gitignore).
# Local Postgres, after running db/schema.sql + db/seed.sql:
DATABASE_URL=postgres://vesi_app:vesi_dev_pw@localhost:5432/vesi_erp_dev

# Production (Neon / Vercel Postgres): set DATABASE_URL in the Vercel
# project's environment variables instead — never commit a real one here.
